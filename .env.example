# 이 파일을 복사해 저장소 루트에 .env를 만들고 값을 채웁니다: cp .env.example .env
# .env는 .gitignore에 포함되어 커밋되지 않습니다. 실제 값은 로컬 .env에만 설정합니다.

# LLM
LLM_API_KEY=

# 국가법령정보 공동활용 (https://open.law.go.kr)
# OC: 신청 시 등록한 이메일의 @ 앞부분(아이디)
LAW_API_OC=

# 공공데이터포털 (https://www.data.go.kr)
# 마이페이지의 일반 인증키 중 "Decoding" 키를 넣습니다. 활용신청한 API는 보통 같은 키를 씁니다.
PUBLIC_DATA_API_KEY=

# 도로명주소 검색 API 승인키 (https://business.juso.go.kr)
JUSO_API_KEY=

# 공공 API 응답 캐시 (document/api_cache/README.md). off면 끔, 경로를 비우면 data/local/public_api_cache.sqlite
PUBLIC_API_CACHE=on
PUBLIC_API_CACHE_PATH=

# 외부 API 요청 제한 시간(초)
EXTERNAL_API_TIMEOUT=10
